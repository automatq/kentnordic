{
  "name": "idcibidci-website",
  "type": "module",
  "version": "1.0.0",
  "description": "Idcibidci ehf — Iceland DMC B2B website (React Router SPA)",
  "scripts": {
    "dev": "vite",
    "dev:admin": "ADMIN_PGLITE_SERIAL=true vercel dev",
    "start": "vite",
    "build": "tsx scripts/materialize-content.ts && tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/build-sitemap.mjs",
    "build:fast": "vite build",
    "preview": "vite preview",
    "verify:colors": "node scripts/verify-color-system.mjs",
    "verify:mobile": "node scripts/verify-mobile-hardening.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/admin-migrate.ts",
    "db:seed": "tsx scripts/admin-seed.ts",
    "admin:import": "tsx scripts/admin-import.ts",
    "admin:reset-pin": "tsx scripts/admin-reset-pin.ts",
    "format": "prettier --write .",
    "gen:map": "node scripts/build-map.mjs"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/m-plus-rounded-1c": "^5.2.10",
    "@neondatabase/serverless": "^1.1.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "^4.0.0",
    "@vercel/blob": "^2.6.1",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.42.2",
    "maath": "^0.10.8",
    "postmark": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^2.0.5",
    "react-markdown": "^9.0.3",
    "react-router-dom": "^7.1.5",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.0.0",
    "three": "^0.185.1",
    "vite": "^6.1.0",
    "ws": "^8.21.0",
    "yaml": "^2.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@electric-sql/pglite": "^0.5.4",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "svgo": "^3.3.2",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vite-imagetools": "^10.0.1",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
