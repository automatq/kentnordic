# Copy to `.env` and fill in. All values are optional for local dev.

# Where inquiry-form submissions are emailed (shown as the contact address too).
PUBLIC_INQUIRY_EMAIL=sales@idcibidci.is

# Admin login password for /admin.
ADMIN_PASSWORD=

# Recommended extra secret for signing admin session cookies.
ADMIN_SESSION_SECRET=

# Production storage: connect a PRIVATE Vercel Blob store to this project so Vercel
# injects BLOB_READ_WRITE_TOKEN (or Blob OIDC envs) into the serverless functions.
