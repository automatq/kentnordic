# Copy to `.env` and fill in. All values are optional for local dev.

# Where inquiry-form submissions are emailed (shown as the contact address too).
PUBLIC_INQUIRY_EMAIL=sales@idcibidci.is

# Web3Forms access key — enables real inquiry delivery.
# Get a free key at https://web3forms.com (enter the destination inbox there).
# Without this key the form runs in demo mode (validates + shows success, no email).
PUBLIC_WEB3FORMS_KEY=
