# Copy to `.env` and fill in. All values are optional for local dev.

# Where inquiry-form submissions are emailed (shown as the contact address too).
PUBLIC_INQUIRY_EMAIL=sales@idcibidci.is

# Admin login password for /admin.
ADMIN_PASSWORD=

# Recommended extra secret for signing admin session cookies.
ADMIN_SESSION_SECRET=

# Vercel sets this for scheduled notification/SLA jobs; provide it when
# invoking the cron endpoint outside Vercel.
CRON_SECRET=

# Neon Postgres connection string. Install Neon from the Vercel Marketplace;
# local admin development falls back to an isolated PGlite database in .context.
DATABASE_URL=

# Optional transactional email. Sending remains disabled until both a verified
# Postmark sender and reply-to mailbox are configured.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
SALES_REPLY_TO_EMAIL=
POSTMARK_WEBHOOK_USER=
POSTMARK_WEBHOOK_PASSWORD=

# Content publishing. The hook points at the production branch and the public
# origin is used to confirm which immutable content release is live.
VERCEL_DEPLOY_HOOK_URL=
PUBLIC_SITE_ORIGIN=https://idcibidci.is

# Feature switches allow staged rollout and immediate rollback.
ADMIN_V2_ENABLED=true
ADMIN_EMAIL_ENABLED=false
ADMIN_CONTENT_PUBLISHING_ENABLED=false

# Production storage: connect a PRIVATE Vercel Blob store to this project so Vercel
# injects BLOB_READ_WRITE_TOKEN (or Blob OIDC envs) into the serverless functions.
