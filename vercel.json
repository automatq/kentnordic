{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]?__path=:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api(?:/|$)|@vite(?:/|$)|@react-refresh(?:/|$)|.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/admin-notifications",
      "schedule": "0 8 * * *"
    }
  ]
}
